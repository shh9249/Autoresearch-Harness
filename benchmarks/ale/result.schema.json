{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AHC026 native adapter result v1",
  "type": "object",
  "required": ["schema_version", "run_id", "task_id", "candidate_id", "status", "stage", "score", "score_direction", "source_sha256", "input_sha256", "phases", "artifacts", "events", "run_dir", "result_path", "retry_count"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string"},
    "task_id": {"type": ["string", "null"]},
    "candidate_id": {"type": ["string", "null"]},
    "public_seed": {"type": ["integer", "null"]},
    "instance_id": {"type": "string"},
    "language": {"type": ["string", "null"]},
    "status": {"enum": ["success", "compile_error", "runtime_error", "timeout", "invalid_output", "output_limit_exceeded", "infrastructure_error", "request_error", "unsupported_task"]},
    "stage": {"enum": ["preflight", "generate", "compile", "run", "score", "complete"]},
    "score": {"type": ["integer", "null"], "minimum": 1},
    "official_reported_score": {"type": "integer", "minimum": 0},
    "score_direction": {"enum": ["maximize", null]},
    "source_sha256": {"type": ["string", "null"]},
    "input_sha256": {"type": ["string", "null"]},
    "phases": {"type": "object", "additionalProperties": {"$ref": "#/$defs/phase"}},
    "artifacts": {"type": "object", "additionalProperties": {"type": "string"}},
    "events": {"type": "array", "items": {"type": "object"}},
    "error": {"type": "object", "required": ["code", "message"]},
    "run_dir": {"type": "string"},
    "result_path": {"type": "string"},
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "retry_count": {"const": 0},
    "budget_accounting": {"const": "not_decided_by_adapter"}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "success"}}}, "then": {"properties": {"score": {"type": "integer", "minimum": 1}, "stage": {"const": "complete"}}}, "else": {"properties": {"score": {"type": "null"}}}}],
  "$defs": {
    "phase": {
      "type": "object",
      "required": ["command", "exit_code", "stdout_path", "stderr_path", "elapsed_seconds", "timed_out", "output_limit_exceeded"],
      "properties": {
        "command": {"type": "array", "items": {"type": "string"}},
        "exit_code": {"type": ["integer", "null"]},
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "stdout_path": {"type": "string"},
        "stderr_path": {"type": "string"},
        "timed_out": {"type": "boolean"},
        "output_limit_exceeded": {"type": "boolean"}
      }
    }
  }
}
