@@ -0,0 +1,197 @@
+/** Checked search policies for the two Organon reproduction variants. */
+import { budgetReport } from './budget.js'
+import { runPaths } from './candidates.js'
+import { DEFAULT_K, DEFAULT_MAX_POPULATION } from './evolve.js'
+import { filesOf } from './files.js'
+import { alive, merit, readPopulation } from './population.js'
+
+const FILE = 'search-policy.json'
+const BASE = Object.freeze({ loop: 'sequential', batch_size: 1, select: 'fitness_proportional', survive: 'top_k' })
+const LOOPS = ['sequential', 'cohort']
+const SELECT = ['fitness_proportional', 'best', 'uniform', 'tournament']
+const SURVIVE = ['top_k', 'recent_with_elite']
+
+export function updatePolicy(variant, policy, args) {
+  const next = { ...policy }
+  for (const [key, value] of Object.entries(args)) {
+    switch (key) {
+      case 'loop':
+        if (!LOOPS.includes(value)) throw new Error('Unknown loop policy.')
+        break
+      case 'batch_size':
+        if (!Number.isSafeInteger(value) || value < 1 || value > 8) throw new Error('batch_size must be 1–8.')
+        break
+      case 'select':
+        if (!SELECT.includes(value)) throw new Error('Unknown parent selection policy.')
+        break
+      case 'survive':
+        if (!SURVIVE.includes(value)) throw new Error('Unknown survival policy.')
+        break
+      case 'guidance':
+        if (variant !== 'v2') throw new Error('Guidance is available only in V2.')
+        if (typeof value !== 'string' || value.length > 2000) throw new Error('Guidance must be at most 2000 characters.')
+        break
+      default:
+        throw new Error('Unknown search policy field: ' + key)
+    }
+    next[key] = key === 'guidance' ? value.trim() : value
+  }
+  return next
+}
+
+const SEARCH_TOOLS = new Set(['evolve_run', 'evolve_status', 'evolve_configure'])
+const FILE_TOOLS = new Set(['read', 'write', 'edit', 'glob', 'grep', 'read_image'])
+
+export function restrictedToolGuard({ name, agent }) {
+  const worker = agent?.session?.header?.origin === 'subagent'
+  if (!(worker ? FILE_TOOLS : SEARCH_TOOLS).has(name)) {
+    return 'This tool is unavailable in the restricted Organon preset.'
+  }
+}
+
+function selectPolicy(policy) {
+  return async population => {
+    const pool = alive(await population.rows())
+    const draw = () => pool[Math.floor(Math.random() * pool.length)]
+    const better = (a, b) => merit(b.fitness) > merit(a.fitness) ? b : a
+    if (pool.length === 0) throw new Error('No alive parent candidate.')
+    if (policy === 'best') return pool.reduce(better).id
+    if (policy === 'tournament') return [draw(), draw(), draw()].reduce(better).id
+    return draw().id
+  }
+}
+
+async function keepRecentWithElite(population, evolve) {
+  const { k } = await evolve.context()
+  const rows = await population.rows()
+  const pool = alive(rows)
+  if (pool.length <= k) return
+  const best = pool.reduce((a, b) => merit(b.fitness) > merit(a.fitness) ? b : a)
+  const ids = new Set([best.id, ...pool.filter(row => row.id !== best.id).reverse().slice(0, k - 1).map(row => row.id)])
+  await population.write(rows.map(row => row.survival === 'yes' && !ids.has(row.id)
+    ? { ...row, survival: 'no' } : row))
+}
+
+function cohortLoop(width) {
+  return async (_args, evolve) => {
+    const population = evolve.population()
+    const { maxPopulation, candidates } = await evolve.context()
+    if ((await population.rows()).length === 0) {
+      const baseline = await evolve.copyTask()
+      await population.append({ id: baseline.id, parent: null, fitness: await evolve.evaluate(baseline), survival: 'yes' })
+    }
+    let remaining = candidates
+    while (remaining > 0) {
+      const { budget } = await evolve.context()
+      const size = Math.min(remaining, budget.remaining, width)
+      if (size === 0) break
+      const parents = []
+      // Freeze parent selection for this cohort; every attempt still spends a slot.
+      for (let i = 0; i < size; i++) parents.push(await evolve.select(population))
+      for (const parent of parents) {
+        const candidate = await evolve.mutate({ parent })
+        const fitness = await evolve.evaluate(candidate)
+        await population.append({ id: candidate.id, parent, fitness, survival: 'yes' })
+      }
+      if (alive(await population.rows()).length >= maxPopulation) await evolve.survive(population)
+      remaining -= size
+    }
+    const rows = await population.rows()
+    const best = rows.reduce((a, b) => merit(b.fitness) > merit(a.fitness) ? b : a)
+    return { best_id: best.id, best_fitness: best.fitness, remaining: (await evolve.context()).budget.remaining }
+  }
+}
+
+async function readState(root, variant) {
+  const text = await filesOf(root).read(FILE)
+  if (text === undefined) return { variant, policy: { ...BASE, ...(variant === 'v2' ? { guidance: '' } : {}) }, revisions: [] }
+  const state = JSON.parse(text)
+  if (state.variant !== variant) throw new Error('Use a separate task workspace for each Organon variant.')
+  return state
+}
+
+function routingOf(agent) {
+  const request = agent.session.requestHeader?.()?.config
+  const route = request ?? agent.options ?? {}
+  return {
+    provider: route.provider ?? null,
+    model: route.model ?? null,
+    reasoningEffort: route.reasoningEffort ?? null,
+    maxTokens: agent.options?.maxTokens ?? null,
+  }
+}
+
+export function installRestrictedTools(ctx, evolve, defineTool, { variant, budget }) {
+  if (!['v1', 'v2'].includes(variant)) throw new Error('ORGANON_VARIANT must be v1 or v2.')
+  if (!Number.isSafeInteger(budget) || budget < 1) throw new Error('ORGANON_BUDGET must be a positive integer.')
+  ctx.tools.guard(restrictedToolGuard)
+  let busy = false
+  async function exclusive(fn) {
+    if (busy) throw new Error('Wait for the current Organon operation to finish.')
+    busy = true
+    try { return await fn() } finally { busy = false }
+  }
+  const tool = (name, description, parameters, execute) => ctx.tools.register(defineTool({
+    name, description, parameters, execute,
+    output: { schema: { type: 'json' }, render: (_args, value) => [{ type: 'text', text: JSON.stringify(value) }] },
+  }))
+  tool('evolve_configure', 'Update the search organization for subsequent chunks. Fields omitted keep their values.',
+    {
+      loop: { type: 'string', enum: LOOPS, description: 'Sequential or fixed-parent cohort scheduling.' },
+      batch_size: { type: 'integer', description: 'Parent cohort width, 1–8, used by the cohort loop.' },
+      select: { type: 'string', enum: SELECT, description: 'Policy for choosing alive parents.' },
+      survive: { type: 'string', enum: SURVIVE, description: 'Keep top k, or keep the elite and recent candidates.' },
+      ...(variant === 'v2' ? { guidance: { type: 'string', description: 'Optional candidate direction appended to the fixed Worker task. An empty string clears the previous guidance.' } } : {}),
+    },
+    (args, exec) => exclusive(async () => {
+      const { root } = runPaths(exec.agent)
+      const state = await readState(root, variant)
+      const previous = state.policy
+      state.policy = updatePolicy(variant, previous, args)
+      const used = (await budgetReport(root))?.used ?? 0
+      state.revisions.push({ used, before: previous, after: state.policy })
+      await filesOf(root).write(FILE, JSON.stringify(state, null, 2) + '\n')
+      return state.policy
+    }))
+  tool('evolve_status', 'Read the task statement, search settings, budget and official candidate history.',
+    {}, async (_args, exec) => {
+      const { root, task } = runPaths(exec.agent)
+      const state = await readState(root, variant)
+      const history = await readPopulation(root)
+      return {
+        variant, policy: state.policy, routing: state.routing, revisions: state.revisions.slice(-8),
+        task: await filesOf(task).read('statement.md'),
+        budget: (await budgetReport(root)) ?? { max: budget, used: 0, remaining: budget },
+        population: history.filter(row => row.survival === 'yes'),
+        recent: history.slice(-20),
+      }
+    })
+  tool('evolve_run', 'Run up to the requested number of candidates using the current policy and fixed evaluator.',
+    { candidates: { type: 'integer', required: true, description: 'Maximum candidates in this chunk.' } },
+    (args, exec) => exclusive(async () => {
+      if (Object.keys(args).some(key => key !== 'candidates')) throw new Error('Only the chunk size may be supplied.')
+      const { root } = runPaths(exec.agent)
+      const state = await readState(root, variant)
+      const { policy } = state
+      const routing = routingOf(exec.agent)
+      if (state.routing && Object.keys(routing).some(key => state.routing[key] !== routing[key])) {
+        throw new Error('The model route or reasoning options differ from the start of this run.')
+      }
+      if (!state.routing) {
+        state.routing = routing
+        await filesOf(root).write(FILE, JSON.stringify(state, null, 2) + '\n')
+      }
+      const disposers = []
+      try {
+        if (policy.loop === 'cohort') disposers.push(evolve.register('loop', cohortLoop(policy.batch_size)))
+        if (policy.select !== 'fitness_proportional') disposers.push(evolve.register('select', selectPolicy(policy.select)))
+        if (policy.survive !== 'top_k') disposers.push(evolve.register('survive', keepRecentWithElite))
+        return await evolve.run({
+          maxBudget: budget, maxPopulation: DEFAULT_MAX_POPULATION, k: DEFAULT_K,
+          candidates: args.candidates, searchGuidance: policy.guidance,
+        }, exec)
+      } finally {
+        disposers.reverse().forEach(dispose => dispose())
+      }
+    }))
+}
