@@ -0,0 +1,116 @@
+import { strict as assert } from 'node:assert'
+import { cp, mkdtemp, readFile, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { test } from 'node:test'
+import { Evolve } from '../src/evolve.js'
+import { defaultInstruction } from '../src/providers/mutate.js'
+import { installRestrictedTools, restrictedToolGuard, updatePolicy } from '../src/restricted.js'
+
+const FIXTURE = fileURLToPath(new URL('./fixtures/task/', import.meta.url))
+
+test('configuration validates search-only keys and version-gates guidance', () => {
+  const defaults = { select: 'best', survive: 'top_k' }
+  assert.throws(() => updatePolicy('v1', defaults, { guidance: 'Try another direction.' }), /only in V2/)
+  for (const key of ['model', 'evaluator', 'system_prompt', 'mutate', 'allowedTools', 'host_code']) {
+    assert.throws(() => updatePolicy('v2', defaults, { [key]: 'override' }), /Unknown search policy field/)
+  }
+  assert.throws(() => updatePolicy('v2', defaults, { batch_size: 9 }), /1–8/)
+  assert.throws(() => updatePolicy('v2', defaults, { loop: 'run_js' }), /Unknown loop/)
+  assert.equal(updatePolicy('v2', defaults, { guidance: '  Prefer small edits. ' }).guidance, 'Prefer small edits.')
+})
+
+test('orchestrator and Worker keep separate operation sets', () => {
+  const worker = { session: { header: { origin: 'subagent' } } }
+  for (const name of ['write', 'bash', 'plugin_manager', 'candidate-builder', 'evolve_activate']) {
+    assert.ok(restrictedToolGuard({ name }))
+  }
+  assert.equal(restrictedToolGuard({ name: 'evolve_configure' }), undefined)
+  assert.equal(restrictedToolGuard({ name: 'edit', agent: worker }), undefined)
+  assert.ok(restrictedToolGuard({ name: 'evolve_configure', agent: worker }))
+  assert.ok(restrictedToolGuard({ name: 'bash', agent: worker }))
+})
+
+test('restricted V1 and V2 use identical core Worker requests and official score path', async () => {
+  const directory = await mkdtemp(join(tmpdir(), 'organon-restricted-'))
+  const initial = await readFile(join(FIXTURE, 'solution.py'), 'utf8')
+  async function exercise(variant) {
+    const task = join(directory, variant)
+    await cp(FIXTURE, task, { recursive: true })
+    const evaluator = join(task, 'evaluator', 'evaluator.py')
+    const evaluatorBefore = await readFile(evaluator)
+    const requests = []
+    const subprocess = {
+      resolveExecutable: async () => 'python',
+      spawn({ argv, cwd }) {
+        assert.equal(cwd, join(task, 'evaluator'))
+        assert.equal(argv.at(-2), task)
+        let text
+        return {
+          done: readFile(argv.at(-1), 'utf8').then(source => {
+            const fitness = Number(source.match(/^VALUE = (\d+)$/m)[1])
+            text = JSON.stringify({ fitness })
+            return { exitCode: 0 }
+          }),
+          collected: { stdout: { readFrom: () => ({ text }) } },
+        }
+      },
+    }
+    const tools = new Map()
+    const ctx = {
+      get: key => key === 'subprocess' ? subprocess : undefined,
+      subagents: {
+        getProvider: () => ({}),
+        async start(name, request) {
+          assert.equal(name, 'candidate-builder')
+          requests.push(request)
+          const result = (async () => {
+            await writeFile(join(request.confine.root, 'solution.py'),
+              initial.replace(/^VALUE = \d+$/m, 'VALUE = ' + String(10 + requests.length)))
+            return { output: [] }
+          })()
+          return { result, dispose: async () => {} }
+        },
+      },
+      tools: { register: tool => tools.set(tool.name, tool), guard: callback => assert.equal(callback, restrictedToolGuard) },
+    }
+    const evolve = new Evolve(ctx)
+    installRestrictedTools(ctx, evolve, x => x, { variant, budget: 3 })
+    const options = { provider: 'fixture', model: 'fixed-model', reasoningEffort: 'none' }
+    const exec = { agent: { options, session: { header: { cwd: task } } } }
+    function call(name, args = {}) { return tools.get(name).execute(args, exec) }
+    assert.deepEqual([...tools.keys()], ['evolve_configure', 'evolve_status', 'evolve_run'])
+    assert.equal('guidance' in tools.get('evolve_configure').parameters, variant === 'v2')
+    await assert.rejects(call('evolve_run', { candidates: 1, max_budget: 900 }), /chunk size/)
+    assert.deepEqual(await call('evolve_run', { candidates: 1 }), { best_id: 'c000001', best_fitness: 11, remaining: 2 })
+    options.model = 'other-model'
+    await assert.rejects(call('evolve_run', { candidates: 1 }), /model route/)
+    options.model = 'fixed-model'
+    const guidance = variant === 'v2' ? { guidance: 'Prioritize small parameter changes.' } : {}
+    await call('evolve_configure', { loop: 'cohort', batch_size: 2, select: 'best', survive: 'recent_with_elite', ...guidance })
+    assert.deepEqual(await call('evolve_run', { candidates: 2 }), { best_id: 'c000003', best_fitness: 13, remaining: 0 })
+    const status = await call('evolve_status')
+    assert.deepEqual(status.recent.map(row => row.parent), [null, 'c000000', 'c000001', 'c000001'])
+    assert.equal(status.revisions[0].used, 1)
+    assert.equal(status.routing.model, 'fixed-model')
+    assert.deepEqual(await readFile(evaluator), evaluatorBefore)
+    return requests
+  }
+  try {
+    const v1 = await exercise('v1')
+    const v2 = await exercise('v2')
+    assert.equal(v1[1].prompt[0].text, defaultInstruction(11))
+    assert.equal(v1[0].prompt[0].text, v2[0].prompt[0].text)
+    assert.ok(v2[1].prompt[0].text.startsWith(defaultInstruction(11) + '\n\n'))
+    assert.ok(v2[1].prompt[0].text.endsWith('Prioritize small parameter changes.'))
+    for (let i = 0; i < v1.length; i++) {
+      assert.equal(v1[i].persona, v2[i].persona)
+      assert.equal(v1[i].agentOptions, undefined)
+      assert.equal(v2[i].agentOptions, undefined)
+      assert.deepEqual({ ...v1[i].confine, root: null }, { ...v2[i].confine, root: null })
+    }
+  } finally {
+    await rm(directory, { recursive: true, force: true })
+  }
+})
