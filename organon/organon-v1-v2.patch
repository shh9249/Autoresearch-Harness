diff --git a/plugins/dsh-evolve-loop/src/restricted.js b/plugins/dsh-evolve-loop/src/restricted.js
new file mode 100644
index 0000000..52e5368
--- /dev/null
+++ b/plugins/dsh-evolve-loop/src/restricted.js
@@ -0,0 +1,426 @@
+/** Restricted Organon tools. Guest policies only return search decisions. */
+import { resolve, sep } from 'node:path'
+import { readFile, realpath } from 'node:fs/promises'
+import { budgetReport } from './budget.js'
+import { candidatePath, runPaths } from './candidates.js'
+import { DEFAULT_K, DEFAULT_MAX_POPULATION } from './evolve.js'
+import { filesOf } from './files.js'
+import { alive, merit, readPopulation } from './population.js'
+import { createPlugin } from './policy-code.js'
+
+const FILE = 'search-policy.json'
+const CONFIGURATION_TOOLS = ['evolve_define', 'evolve_activate', 'evolve_deactivate', 'evolve_plugins',
+  'evolve_run', 'evolve_status', 'evolve_inspect', 'evolve_set_guidance']
+const WORKER_FILE_TOOLS = new Set(['read', 'write', 'edit', 'glob', 'grep', 'read_image'])
+
+export function restrictedToolGuard({ name, agent }) {
+  const worker = agent?.session?.header?.origin === 'subagent'
+  if (!(worker ? WORKER_FILE_TOOLS.has(name) : CONFIGURATION_TOOLS.includes(name))) {
+    return 'This tool is unavailable in the restricted Organon preset.'
+  }
+}
+
+function routingOf(agent) {
+  const request = agent.session.requestHeader?.()?.config
+  const route = request ?? agent.options ?? {}
+  return {
+    provider: route.provider ?? null,
+    model: route.model ?? null,
+    reasoningEffort: route.reasoningEffort ?? null,
+    maxTokens: agent.options?.maxTokens ?? null,
+  }
+}
+
+async function readState(root, variant) {
+  const text = await filesOf(root).read(FILE)
+  if (text === undefined) return { variant, plugins: [], active: [], revisions: [], nextGuidance: '', pluginState: {} }
+  const state = JSON.parse(text)
+  if (state.variant !== variant) throw new Error('Use a separate task workspace for each Organon variant.')
+  if (!Array.isArray(state.plugins) || !Array.isArray(state.active)) {
+    throw new Error('Use a fresh task workspace for the runtime-plugin baseline.')
+  }
+  state.pluginState ??= {}
+  return state
+}
+
+async function save(root, state) {
+  await filesOf(root).write(FILE, JSON.stringify(state, null, 2) + '\n')
+}
+
+function providers(state) {
+  const hooks = {}
+  for (const active of state.active) {
+    const plugin = pluginById(state, active.plugin_id)
+    const version = packageById(plugin, active.package_id)
+    for (const slot of version.slots) hooks[slot] = { plugin: plugin.id, version: version.id, code: version.code }
+  }
+  return hooks
+}
+
+function pluginById(state, id) {
+  const plugin = state.plugins.find(item => item.id === id)
+  if (!plugin) throw new Error('Unknown plugin: ' + id)
+  return plugin
+}
+
+function packageById(plugin, id) {
+  const version = id ? plugin.versions.find(item => item.id === id) : plugin.versions.at(-1)
+  if (!version) throw new Error('Unknown plugin version: ' + id)
+  return version
+}
+
+function inventory(state) {
+  const hooks = providers(state)
+  return {
+    plugins: state.plugins.map(plugin => ({
+      id: plugin.id, versions: plugin.versions.map(({code, ...version}) => version),
+    })),
+    active: state.active,
+    providers: Object.fromEntries(Object.entries(hooks).map(([slot, hook]) => [
+      slot, { plugin_id: hook.plugin, package_id: hook.version },
+    ])),
+  }
+}
+
+async function readInside(root, filename) {
+  if (typeof filename !== 'string' || !filename || filename === '.') throw new Error('Invalid program path.')
+  const boundary = await realpath(root)
+  const target = await realpath(resolve(boundary, filename))
+  if (!target.startsWith(boundary + sep)) throw new Error('Only the nominated program inside the task is readable.')
+  return readFile(target, 'utf8')
+}
+
+function guidanceText(text) {
+  if (typeof text !== 'string') throw new Error('Guidance must be text.')
+  return text.trim()
+}
+
+function normalizePlan(raw, rows) {
+  const plan = typeof raw === 'string' ? { parent_id: raw } : raw
+  if (!plan || typeof plan !== 'object' || Array.isArray(plan)
+      || Object.keys(plan).some(key => !['parent_id', 'donors'].includes(key))) {
+    throw new Error('Return { parent_id, donors? } for each candidate.')
+  }
+  if (!rows.some(row => row.id === plan.parent_id)) throw new Error('Unknown primary parent ID.')
+  const donors = plan.donors ?? []
+  if (!Array.isArray(donors) || new Set(donors).size !== donors.length
+      || donors.some(id => id === plan.parent_id || !rows.some(row => row.id === id))) {
+    throw new Error('Specify distinct recorded or generated donor IDs other than the primary parent.')
+  }
+  return { parent_id: plan.parent_id, donors }
+}
+
+function chooseSurvivors(ids, history) {
+  if (!Array.isArray(ids) || new Set(ids).size !== ids.length || ids.some(id => !history.some(row => row.id === id))) {
+    throw new Error('Population membership must be a list of distinct evaluated candidate IDs.')
+  }
+  return new Set(ids)
+}
+
+function scheduleRun(state, root, hooks, guest) {
+  return async (_args, evolve) => {
+    const population = evolve.population()
+    const { candidates, maxPopulation, k, task, budget: start } = await evolve.context()
+    const { program } = JSON.parse(await readFile(resolve(task, 'task.json'), 'utf8'))
+    state.pendingCandidates ??= {}
+    if ((await population.rows()).length === 0) {
+      const baseline = await evolve.copyTask()
+      await population.append({ id: baseline.id, parent: null, fitness: await evolve.evaluate(baseline), survival: 'yes' })
+    }
+
+    async function view() {
+      const history = await population.rows()
+      const { budget } = await evolve.context()
+      const pending = Object.values(state.pendingCandidates).filter(item => !history.some(row => row.id === item.id))
+      return { history, alive: alive(history), pending, budget, k, maxPopulation,
+        remaining: Math.min(candidates - (budget.used - start.used), budget.remaining) }
+    }
+
+    async function select(feed) {
+      return hooks.select ? (await guest.invoke('select', feed)).result : evolve.select(population)
+    }
+
+    async function generate(raw) {
+      const feed = await view()
+      if (feed.remaining <= 0) throw new Error('The candidate budget for this chunk is exhausted.')
+      const known = [...feed.history, ...feed.pending]
+      const { parent_id, donors } = normalizePlan(raw, known)
+      const donorsForPrompt = await Promise.all(donors.map(async id => ({
+        id, fitness: known.find(row => row.id === id).fitness ?? null,
+        source: await readInside(candidatePath(root, id), program),
+      })))
+      const primary = known.find(row => row.id === parent_id)
+      const oneShot = state.nextGuidance
+      const dynamic = hooks.guidance && !oneShot ? guidanceText((await guest.invoke('guidance', {
+        ...feed, primary, donors: donorsForPrompt,
+      })).result) : ''
+      const guidance = oneShot || dynamic
+      const candidate = await evolve.mutate({ parent: parent_id, donorContext: donorsForPrompt, searchGuidance: guidance })
+      const row = { id: candidate.id, parent: parent_id,
+        ...(donors.length ? { donors } : {}),
+        ...(guidance ? { guidance } : {}) }
+      state.pendingCandidates[candidate.id] = row
+      if (oneShot) {
+        state.nextGuidance = ''
+        state.revisions.push({ kind: 'consume_guidance', candidate: candidate.id })
+      }
+      await save(root, state)
+      return row
+    }
+
+    async function evaluate(id) {
+      const existing = (await population.rows()).find(row => row.id === id)
+      if (existing) return existing
+      if (typeof id !== 'string' || !Object.hasOwn(state.pendingCandidates, id)) {
+        throw new Error('Evaluation requires a generated candidate ID.')
+      }
+      const draft = state.pendingCandidates[id]
+      const fitness = await evolve.evaluate({ id, dir: candidatePath(root, id) })
+      const row = { ...draft, fitness, survival: 'yes' }
+      await population.append(row)
+      delete state.pendingCandidates[id]
+      await save(root, state)
+      return row
+    }
+
+    async function setPopulation(ids, feed) {
+      const members = chooseSurvivors(ids, feed.history)
+      await population.write(feed.history.map(row => ({ ...row, survival: members.has(row.id) ? 'yes' : 'no' })))
+      return ids
+    }
+
+    async function survive(feed) {
+      if (!hooks.survive) {
+        await evolve.survive(population)
+        return alive(await population.rows()).map(row => row.id)
+      }
+      return setPopulation((await guest.invoke('survive', feed)).result, feed)
+    }
+
+    async function dispatch(request) {
+      if (!request || typeof request !== 'object') throw new Error('Yield an operation object.')
+      const { op, ...args } = request
+      switch (op) {
+        case 'state': return view()
+        case 'select': return select(await view())
+        case 'generate': return generate(args)
+        case 'evaluate': return evaluate(args.id)
+        case 'survive': return survive(await view())
+        case 'set_population': return setPopulation(args.ids, await view())
+        default: throw new Error('Unknown loop operation: ' + op)
+      }
+    }
+
+    // Generator loops control operation ordering, including when to inspect feedback or prune.
+    // Existing synchronous loop hooks remain compatible with the upstream candidate cycle.
+    try {
+      while (true) {
+        const feed = await view()
+        if (!feed.remaining && (!hooks.loop || !feed.pending.length)) break
+        let step = hooks.loop ? await guest.invoke('loop', feed) : { result: null }
+        if (step.yielded || step.finished) {
+          let commands = 0
+          while (step.yielded) {
+            evolve.currentRun().signal.throwIfAborted()
+            if (++commands > 1000 + 20 * candidates) throw new Error('Loop exceeded its operation limit.')
+            step = await guest.resumeLoop(await dispatch(step.result))
+          }
+          break
+        }
+        if (!feed.remaining) break
+        const batch = Array.isArray(step.result) ? step.result : [step.result]
+        if (!batch.length || batch.length > feed.remaining) throw new Error('loop must schedule between 1 and remaining candidates.')
+        const plans = []
+        for (const item of batch) plans.push(normalizePlan(item ?? await select(feed), [...feed.history, ...feed.pending]))
+        for (const plan of plans) {
+          await evaluate((await generate(plan)).id)
+          const after = await view()
+          if (after.alive.length >= maxPopulation) await survive(after)
+        }
+      }
+    } finally {
+      if (hooks.loop) guest.closeLoop()
+    }
+    const searched = await view()
+    const best = searched.history.reduce((a, b) => merit(b.fitness) > merit(a.fitness) ? b : a)
+    return { best_id: best.id, best_fitness: best.fitness, remaining: searched.budget.remaining }
+  }
+}
+
+export function installRestrictedTools(ctx, evolve, defineTool, { variant, budget }) {
+  if (!['v1', 'v2'].includes(variant)) throw new Error('ORGANON_VARIANT must be v1 or v2.')
+  if (!Number.isSafeInteger(budget) || budget < 1) throw new Error('ORGANON_BUDGET must be a positive integer.')
+  const allowed = ['loop', 'select', 'survive', ...(variant === 'v2' ? ['guidance'] : [])]
+  // One live realm per activated version and run. Different tasks can reuse version IDs.
+  const liveRuns = new Map()
+  function runtimes(root) {
+    if (!liveRuns.has(root)) liveRuns.set(root, new Map())
+    return liveRuns.get(root)
+  }
+  ctx.tools.guard(restrictedToolGuard)
+  const field = (type, description, required = false) => ({ type, description, required })
+  let busy = false
+  function tool(name, description, parameters, fn, exclusive = false) {
+    ctx.tools.register(defineTool({
+      name, description, parameters,
+      async execute(args, exec) {
+        if (exclusive && busy) throw new Error('Wait for the current Organon operation to finish.')
+        if (exclusive) busy = true
+        try {
+          const paths = runPaths(exec.agent)
+          return await fn(args, exec, paths, await readState(paths.root, variant))
+        } finally {
+          if (exclusive) busy = false
+        }
+      },
+      output: { schema: { type: 'json' }, render: (_args, value) => [{ type: 'text', text: JSON.stringify(value) }] },
+    }))
+  }
+  async function revise(root, state, details) {
+    state.revisions.push({ used: (await budgetReport(root))?.used ?? 0, ...details })
+    await save(root, state)
+  }
+  tool('evolve_define', 'Define JavaScript returning a search plugin object. For full scheduling use *loop(state) and yield '
+    + 'operation objects: {op:"state"}, {op:"select"}, {op:"generate",parent_id,donors?}, {op:"evaluate",id}, '
+    + '{op:"survive"}, or {op:"set_population",ids}. Each yield receives its result. Return to end the chunk. '
+    + 'A plain loop(state) can still return plans for the default generate/evaluate/cull cycle. '
+    + 'Select returns an ID or {parent_id, donors}; survive returns any subset of evaluated IDs including archived candidates. '
+    + 'V2 may export guidance(state) returning text. State exposes history, alive, pending, budget, remaining, k and maxPopulation. '
+    + 'Hooks share module variables until deactivation or process restart. State also includes a zero-based '
+    + 'hook turn and shared state.memory, which you can update with JSON to survive restart. '
+    + 'Hooks run synchronously on copied data. Activate the returned version to use it.', {
+    name: field('string', 'Plugin name.', true),
+    purpose: field('string', 'Expected effect and evidence.', true),
+    host_code: field('string', 'JavaScript body returning the hook object.', true),
+    plugin_id: field('string', 'Existing plugin ID when defining a new version.'),
+  }, async (args, _exec, { root }, state) => {
+    const { slots } = createPlugin(args.host_code, allowed)
+    const plugin = args.plugin_id ? pluginById(state, args.plugin_id) : { id: 'evo-' + (state.plugins.length + 1), versions: [] }
+    if (!args.plugin_id) state.plugins.push(plugin)
+    const id = plugin.id + '-v' + (plugin.versions.length + 1)
+    plugin.versions.push({ id, name: args.name, purpose: args.purpose, slots, code: args.host_code })
+    await revise(root, state, { kind: 'define', plugin_id: plugin.id, package_id: id })
+    return { plugin_id: plugin.id, package_id: id, slots }
+  }, true)
+  tool('evolve_activate', 'Activate a defined plugin version between chunks.', {
+    plugin_id: field('string', 'Plugin ID.', true), package_id: field('string', 'Defaults to the latest version.'),
+  }, async (args, _exec, { root }, state) => {
+    const plugin = pluginById(state, args.plugin_id)
+    const version = packageById(plugin, args.package_id)
+    const current = state.active.find(active => active.plugin_id === plugin.id)
+    const live = runtimes(root)
+    const retained = current?.package_id === version.id
+    const runtime = (retained && live.get(version.id)) || createPlugin(version.code, allowed)
+    if (current && !retained) delete state.pluginState[current.package_id]
+    state.active = state.active.filter(active => active.plugin_id !== plugin.id)
+    const entry = { plugin_id: plugin.id, package_id: version.id }
+    state.active.push(entry)
+    await revise(root, state, { kind: 'activate', ...entry })
+    if (current && !retained) live.delete(current.package_id)
+    live.set(version.id, runtime)
+    return { ...entry, providers: inventory(state).providers }
+  }, true)
+  tool('evolve_deactivate', 'Deactivate a plugin and restore the previous provider for its hooks.', {
+    plugin_id: field('string', 'Plugin ID.', true),
+  }, async (args, _exec, { root }, state) => {
+    pluginById(state, args.plugin_id)
+    const current = state.active.find(active => active.plugin_id === args.plugin_id)
+    if (current) delete state.pluginState[current.package_id]
+    state.active = state.active.filter(active => active.plugin_id !== args.plugin_id)
+    await revise(root, state, { kind: 'deactivate', plugin_id: args.plugin_id })
+    if (current) runtimes(root).delete(current.package_id)
+    return inventory(state)
+  }, true)
+  tool('evolve_plugins', 'List defined versions and currently active hooks.', {},
+    async (_args, _exec, _paths, state) => inventory(state))
+  if (variant === 'v2') {
+    tool('evolve_set_guidance', 'Queue a text direction for the next candidate. Empty text clears it.', {
+      guidance: field('string', 'Single-candidate direction.', true),
+    }, async (args, _exec, { root }, state) => {
+      state.nextGuidance = guidanceText(args.guidance)
+      await revise(root, state, { kind: 'set_guidance', guidance: state.nextGuidance })
+      return { guidance: state.nextGuidance }
+    }, true)
+  }
+  tool('evolve_status', 'Read the task statement, active search hooks, budget and official candidate history.', {},
+    async (_args, _exec, { root, task }, state) => {
+      const history = await readPopulation(root)
+      return {
+        variant, routing: state.routing, revisions: state.revisions.slice(-8), ...inventory(state),
+        task: await filesOf(task).read('statement.md'),
+        budget: (await budgetReport(root)) ?? { max: budget, used: 0, remaining: budget },
+        history,
+        pending: Object.values(state.pendingCandidates ?? {}).filter(item => !history.some(row => row.id === item.id)),
+      }
+    })
+  tool('evolve_inspect', 'Read the original task source, the fixed evaluator entry point, or a recorded candidate source or evaluation JSON. '
+    + 'Use evolve_status for complete lineage history.', {
+    artifact: { type: 'string', required: true, enum: ['source', 'evaluation', 'evaluator'], description: 'Artifact to read.' },
+    candidate_id: field('string', 'Recorded candidate ID; omit for the original task source.'),
+  }, async (args, _exec, { root, task }) => {
+    const id = args.candidate_id
+    if (id !== undefined && (!/^c\d{6}$/.test(id) || !(await readPopulation(root)).some(row => row.id === id))) {
+      throw new Error('Unknown evaluated candidate ID.')
+    }
+    if (args.artifact === 'evaluation' && id !== undefined) {
+      const content = await readInside(resolve(root, 'evals'), id + '.json')
+      return { evaluation: JSON.parse(content) }
+    }
+    if (args.artifact === 'evaluator' && id === undefined) {
+      return { source: await readInside(task, 'evaluator/evaluator.py') }
+    }
+    if (args.artifact !== 'source') throw new Error('Use an ID for an evaluation and omit the ID for the evaluator.')
+    const { program } = JSON.parse(await readInside(task, 'task.json'))
+    return { program, source: await readInside(id ? candidatePath(root, id) : task, program) }
+  })
+  tool('evolve_run', 'Run up to the requested number of candidates, using active hooks and the fixed evaluator.', {
+    candidates: field('integer', 'Maximum candidates in this chunk.', true),
+  }, async (args, exec, { root }, state) => {
+    if (Object.keys(args).some(key => key !== 'candidates') || !Number.isSafeInteger(args.candidates) || args.candidates < 1) {
+      throw new Error('Supply only a positive candidate chunk size.')
+    }
+    const routing = routingOf(exec.agent)
+    if (state.routing && Object.keys(routing).some(key => state.routing[key] !== routing[key])) {
+      throw new Error('The model route or reasoning options differ from the start of this run.')
+    }
+    if (!state.routing) {
+      state.routing = routing
+      await save(root, state)
+    }
+    const hooks = providers(state)
+    const live = runtimes(root)
+    function runtime(slot) {
+      const { version, code } = hooks[slot]
+      if (!live.has(version)) live.set(version, createPlugin(code, allowed))
+      return live.get(version)
+    }
+    async function storeHookState(version, output, turns) {
+      state.pluginState[version] = { turns, memory: output.memory }
+      await save(root, state)
+      return output
+    }
+    async function invoke(slot, input) {
+      const { version } = hooks[slot]
+      const checkpoint = state.pluginState[version] ?? { turns: {}, memory: {} }
+      const turn = checkpoint.turns[slot] ?? 0
+      const output = runtime(slot).invoke(slot, { ...input, turn, memory: checkpoint.memory })
+      return storeHookState(version, output, { ...checkpoint.turns, [slot]: turn + 1 })
+    }
+    const guest = {
+      invoke,
+      resumeLoop(value) {
+        const { version } = hooks.loop
+        return storeHookState(version, runtime('loop').resume(value), state.pluginState[version].turns)
+      },
+      closeLoop() { live.get(hooks.loop.version)?.close() },
+    }
+    const dispose = evolve.register('loop', scheduleRun(state, root, hooks, guest))
+    try {
+      return await evolve.run({
+        maxBudget: budget, maxPopulation: DEFAULT_MAX_POPULATION, k: DEFAULT_K, candidates: args.candidates,
+      }, exec)
+    } finally {
+      dispose()
+    }
+  }, true)
+}
