diff --git a/plugins/dsh-evolve-loop/src/restricted.js b/plugins/dsh-evolve-loop/src/restricted.js
new file mode 100644
index 0000000..235c57a
--- /dev/null
+++ b/plugins/dsh-evolve-loop/src/restricted.js
@@ -0,0 +1,318 @@
+/** Restricted Organon tools. Guest policies only return search decisions. */
+import { resolve, sep } from 'node:path'
+import { readFile, realpath } from 'node:fs/promises'
+import { budgetReport } from './budget.js'
+import { candidatePath, runPaths } from './candidates.js'
+import { DEFAULT_K, DEFAULT_MAX_POPULATION } from './evolve.js'
+import { filesOf } from './files.js'
+import { alive, merit, readPopulation } from './population.js'
+import { executePlugin } from './policy-code.js'
+
+const FILE = 'search-policy.json'
+const CONFIGURATION_TOOLS = ['evolve_define', 'evolve_activate', 'evolve_deactivate', 'evolve_plugins',
+  'evolve_run', 'evolve_status', 'evolve_inspect', 'evolve_set_guidance']
+const WORKER_FILE_TOOLS = new Set(['read', 'write', 'edit', 'glob', 'grep', 'read_image'])
+
+export function restrictedToolGuard({ name, agent }) {
+  const worker = agent?.session?.header?.origin === 'subagent'
+  if (!(worker ? WORKER_FILE_TOOLS.has(name) : CONFIGURATION_TOOLS.includes(name))) {
+    return 'This tool is unavailable in the restricted Organon preset.'
+  }
+}
+
+function routingOf(agent) {
+  const request = agent.session.requestHeader?.()?.config
+  const route = request ?? agent.options ?? {}
+  return {
+    provider: route.provider ?? null,
+    model: route.model ?? null,
+    reasoningEffort: route.reasoningEffort ?? null,
+    maxTokens: agent.options?.maxTokens ?? null,
+  }
+}
+
+async function readState(root, variant) {
+  const text = await filesOf(root).read(FILE)
+  if (text === undefined) return { variant, plugins: [], active: [], revisions: [], nextGuidance: '' }
+  const state = JSON.parse(text)
+  if (state.variant !== variant) throw new Error('Use a separate task workspace for each Organon variant.')
+  if (!Array.isArray(state.plugins) || !Array.isArray(state.active)) {
+    throw new Error('Use a fresh task workspace for the runtime-plugin baseline.')
+  }
+  return state
+}
+
+async function save(root, state) {
+  await filesOf(root).write(FILE, JSON.stringify(state, null, 2) + '\n')
+}
+
+function providers(state) {
+  const hooks = {}
+  for (const active of state.active) {
+    const plugin = pluginById(state, active.plugin_id)
+    const version = packageById(plugin, active.package_id)
+    for (const slot of version.slots) hooks[slot] = { plugin: plugin.id, version: version.id, code: version.code }
+  }
+  return hooks
+}
+
+function pluginById(state, id) {
+  const plugin = state.plugins.find(item => item.id === id)
+  if (!plugin) throw new Error('Unknown plugin: ' + id)
+  return plugin
+}
+
+function packageById(plugin, id) {
+  const version = id ? plugin.versions.find(item => item.id === id) : plugin.versions.at(-1)
+  if (!version) throw new Error('Unknown plugin version: ' + id)
+  return version
+}
+
+function inventory(state) {
+  const hooks = providers(state)
+  return {
+    plugins: state.plugins.map(plugin => ({
+      id: plugin.id, versions: plugin.versions.map(({code, ...version}) => version),
+    })),
+    active: state.active,
+    providers: Object.fromEntries(Object.entries(hooks).map(([slot, hook]) => [
+      slot, { plugin_id: hook.plugin, package_id: hook.version },
+    ])),
+  }
+}
+
+async function readInside(root, filename) {
+  if (typeof filename !== 'string' || !filename || filename === '.') throw new Error('Invalid program path.')
+  const boundary = await realpath(root)
+  const target = await realpath(resolve(boundary, filename))
+  if (!target.startsWith(boundary + sep)) throw new Error('Only the nominated program inside the task is readable.')
+  return readFile(target, 'utf8')
+}
+
+function guidanceText(text) {
+  if (typeof text !== 'string' || text.length > 2000) throw new Error('Guidance must be text of up to 2,000 characters.')
+  return text.trim()
+}
+
+function normalizePlan(raw, rows) {
+  const plan = typeof raw === 'string' ? { parent_id: raw } : raw
+  if (!plan || typeof plan !== 'object' || Array.isArray(plan)
+      || Object.keys(plan).some(key => !['parent_id', 'donors'].includes(key))) {
+    throw new Error('Return { parent_id, donors? } for each candidate.')
+  }
+  if (!alive(rows).some(row => row.id === plan.parent_id)) throw new Error('The primary parent must be alive.')
+  const donorIds = plan.donors ?? []
+  if (!Array.isArray(donorIds) || donorIds.length > 4 || new Set(donorIds).size !== donorIds.length
+      || donorIds.some(id => id === plan.parent_id || !rows.some(row => row.id === id && merit(row.fitness) > 0))) {
+    throw new Error('Specify at most four distinct, successfully evaluated donor IDs other than the primary parent.')
+  }
+  return { parent_id: plan.parent_id, donors: donorIds }
+}
+
+function chooseSurvivors(result, pool, maximum) {
+  if (!Array.isArray(result) || result.length === 0 || result.length > maximum
+      || new Set(result).size !== result.length || result.some(id => !pool.some(row => row.id === id))) {
+    throw new Error('survive must return a nonempty list of distinct alive IDs within maxPopulation.')
+  }
+  return new Set(result)
+}
+
+function scheduleRun(state, allowed, root, hooks) {
+  const invoke = (slot, input) => executePlugin(hooks[slot].code, allowed, slot, input)
+  return async (_args, evolve) => {
+    const population = evolve.population()
+    const { candidates, maxPopulation, k, task } = await evolve.context()
+    const { program } = JSON.parse(await readFile(resolve(task, 'task.json'), 'utf8'))
+    if ((await population.rows()).length === 0) {
+      const baseline = await evolve.copyTask()
+      await population.append({ id: baseline.id, parent: null, fitness: await evolve.evaluate(baseline), survival: 'yes' })
+    }
+
+    const view = async () => {
+      const history = await population.rows()
+      return { history, alive: alive(history), budget: (await evolve.context()).budget, k, maxPopulation }
+    }
+
+    let used = 0
+    while (used < candidates) {
+      const feed = await view()
+      const remaining = Math.min(candidates - used, feed.budget.remaining)
+      if (!remaining) break
+      const options = { ...feed, remaining }
+      const scheduled = hooks.loop ? invoke('loop', options) : null
+      const batch = Array.isArray(scheduled) ? scheduled : [scheduled]
+      if (!batch.length || batch.length > remaining) throw new Error('loop must schedule between 1 and remaining candidates.')
+      const plans = []
+      for (const item of batch) {
+        const selected = item ?? (hooks.select ? invoke('select', options) : await evolve.select(population))
+        plans.push(normalizePlan(selected, feed.history))
+      }
+      for (const { parent_id, donors } of plans) {
+        const donorsForPrompt = await Promise.all(donors.map(async id => ({
+          id, fitness: feed.history.find(row => row.id === id).fitness,
+          source: await readInside(candidatePath(root, id), program),
+        })))
+        const fixedParent = feed.history.find(row => row.id === parent_id)
+        const oneShot = state.nextGuidance
+        const dynamic = hooks.guidance && !oneShot ? guidanceText(invoke('guidance', {
+          ...(await view()), primary: fixedParent, donors: donorsForPrompt,
+        })) : ''
+        const guidance = oneShot || dynamic
+        const candidate = await evolve.mutate({ parent: parent_id, donorContext: donorsForPrompt, searchGuidance: guidance })
+        if (oneShot) {
+          state.nextGuidance = ''
+          state.revisions.push({ kind: 'consume_guidance', candidate: candidate.id })
+          await save(root, state)
+        }
+        const fitness = await evolve.evaluate(candidate)
+        await population.append({
+          id: candidate.id, parent: parent_id, fitness, survival: 'yes',
+          ...(donors.length ? { donors } : {}),
+          ...(guidance ? { guidance } : {}),
+        })
+        used++
+        const after = await view()
+        if (after.alive.length >= maxPopulation) {
+          if (!hooks.survive) {
+            await evolve.survive(population)
+          } else {
+            const survivors = chooseSurvivors(invoke('survive', after), after.alive, maxPopulation)
+            await population.write(after.history.map(row => row.survival === 'yes' && !survivors.has(row.id)
+              ? { ...row, survival: 'no' } : row))
+          }
+        }
+      }
+    }
+    const rows = await population.rows()
+    const best = rows.reduce((a, b) => merit(b.fitness) > merit(a.fitness) ? b : a)
+    return { best_id: best.id, best_fitness: best.fitness, remaining: (await evolve.context()).budget.remaining }
+  }
+}
+
+export function installRestrictedTools(ctx, evolve, defineTool, { variant, budget }) {
+  if (!['v1', 'v2'].includes(variant)) throw new Error('ORGANON_VARIANT must be v1 or v2.')
+  if (!Number.isSafeInteger(budget) || budget < 1) throw new Error('ORGANON_BUDGET must be a positive integer.')
+  const allowed = ['loop', 'select', 'survive', ...(variant === 'v2' ? ['guidance'] : [])]
+  ctx.tools.guard(restrictedToolGuard)
+  const field = (type, description, required = false) => ({ type, description, required })
+  let busy = false
+  function tool(name, description, parameters, fn, exclusive = false) {
+    ctx.tools.register(defineTool({
+      name, description, parameters,
+      async execute(args, exec) {
+        if (exclusive && busy) throw new Error('Wait for the current Organon operation to finish.')
+        if (exclusive) busy = true
+        try {
+          const paths = runPaths(exec.agent)
+          return await fn(args, exec, paths, await readState(paths.root, variant))
+        } finally {
+          if (exclusive) busy = false
+        }
+      },
+      output: { schema: { type: 'json' }, render: (_args, value) => [{ type: 'text', text: JSON.stringify(value) }] },
+    }))
+  }
+  async function revise(root, state, details) {
+    state.revisions.push({ used: (await budgetReport(root))?.used ?? 0, ...details })
+    await save(root, state)
+  }
+  tool('evolve_define', 'Define JavaScript with return { select(state) { return state.alive[0].id } }. '
+    + 'Hooks: loop returns one or more parent plans; null entries delegate to selection. Select returns an ID or {parent_id, donors}. '
+    + 'survive returns retained IDs at the population threshold. V2 may export guidance(state) returning text. '
+    + 'State exposes history, alive, budget, k and maxPopulation; loop also gets remaining, guidance gets primary and donors. '
+    + 'Hooks run synchronously on copied data. Activate the returned version to use it.', {
+    name: field('string', 'Plugin name.', true),
+    purpose: field('string', 'Expected effect and evidence.', true),
+    host_code: field('string', 'JavaScript body returning the hook object.', true),
+    plugin_id: field('string', 'Existing plugin ID when defining a new version.'),
+  }, async (args, _exec, { root }, state) => {
+    const slots = executePlugin(args.host_code, allowed)
+    const plugin = args.plugin_id ? pluginById(state, args.plugin_id) : { id: 'evo-' + (state.plugins.length + 1), versions: [] }
+    if (!args.plugin_id) state.plugins.push(plugin)
+    const id = plugin.id + '-v' + (plugin.versions.length + 1)
+    plugin.versions.push({ id, name: args.name, purpose: args.purpose, slots, code: args.host_code })
+    await revise(root, state, { kind: 'define', plugin_id: plugin.id, package_id: id })
+    return { plugin_id: plugin.id, package_id: id, slots }
+  }, true)
+  tool('evolve_activate', 'Activate a defined plugin version between chunks.', {
+    plugin_id: field('string', 'Plugin ID.', true), package_id: field('string', 'Defaults to the latest version.'),
+  }, async (args, _exec, { root }, state) => {
+    const plugin = pluginById(state, args.plugin_id)
+    const version = packageById(plugin, args.package_id)
+    executePlugin(version.code, allowed)
+    state.active = state.active.filter(active => active.plugin_id !== plugin.id)
+    const entry = { plugin_id: plugin.id, package_id: version.id }
+    state.active.push(entry)
+    await revise(root, state, { kind: 'activate', ...entry })
+    return { ...entry, providers: inventory(state).providers }
+  }, true)
+  tool('evolve_deactivate', 'Deactivate a plugin and restore the previous provider for its hooks.', {
+    plugin_id: field('string', 'Plugin ID.', true),
+  }, async (args, _exec, { root }, state) => {
+    pluginById(state, args.plugin_id)
+    state.active = state.active.filter(active => active.plugin_id !== args.plugin_id)
+    await revise(root, state, { kind: 'deactivate', plugin_id: args.plugin_id })
+    return inventory(state)
+  }, true)
+  tool('evolve_plugins', 'List defined versions and currently active hooks.', {},
+    async (_args, _exec, _paths, state) => inventory(state))
+  if (variant === 'v2') {
+    tool('evolve_set_guidance', 'Queue a text direction for the next candidate. Empty text clears it.', {
+      guidance: field('string', 'Single-candidate direction, up to 2,000 characters.', true),
+    }, async (args, _exec, { root }, state) => {
+      state.nextGuidance = guidanceText(args.guidance)
+      await revise(root, state, { kind: 'set_guidance', guidance: state.nextGuidance })
+      return { guidance: state.nextGuidance }
+    }, true)
+  }
+  tool('evolve_status', 'Read the task statement, active search hooks, budget and official candidate history.', {},
+    async (_args, _exec, { root, task }, state) => ({
+      variant, routing: state.routing, revisions: state.revisions.slice(-8), ...inventory(state),
+      task: await filesOf(task).read('statement.md'),
+      budget: (await budgetReport(root)) ?? { max: budget, used: 0, remaining: budget },
+      history: await readPopulation(root),
+    }))
+  tool('evolve_inspect', 'Read the original task source, the fixed evaluator entry point, or a recorded candidate source or evaluation JSON. '
+    + 'Use evolve_status for complete lineage history.', {
+    artifact: { type: 'string', required: true, enum: ['source', 'evaluation', 'evaluator'], description: 'Artifact to read.' },
+    candidate_id: field('string', 'Recorded candidate ID; omit for the original task source.'),
+  }, async (args, _exec, { root, task }) => {
+    const id = args.candidate_id
+    if (id !== undefined && (!/^c\d{6}$/.test(id) || !(await readPopulation(root)).some(row => row.id === id))) {
+      throw new Error('Unknown evaluated candidate ID.')
+    }
+    if (args.artifact === 'evaluation' && id !== undefined) {
+      const content = await readInside(resolve(root, 'evals'), id + '.json')
+      return { evaluation: JSON.parse(content) }
+    }
+    if (args.artifact === 'evaluator' && id === undefined) {
+      return { source: await readInside(task, 'evaluator/evaluator.py') }
+    }
+    if (args.artifact !== 'source') throw new Error('Use an ID for an evaluation and omit the ID for the evaluator.')
+    const { program } = JSON.parse(await readInside(task, 'task.json'))
+    return { program, source: await readInside(id ? candidatePath(root, id) : task, program) }
+  })
+  tool('evolve_run', 'Run up to the requested number of candidates, using active hooks and the fixed evaluator.', {
+    candidates: field('integer', 'Maximum candidates in this chunk.', true),
+  }, async (args, exec, { root }, state) => {
+    if (Object.keys(args).some(key => key !== 'candidates') || !Number.isSafeInteger(args.candidates) || args.candidates < 1) {
+      throw new Error('Supply only a positive candidate chunk size.')
+    }
+    const routing = routingOf(exec.agent)
+    if (state.routing && Object.keys(routing).some(key => state.routing[key] !== routing[key])) {
+      throw new Error('The model route or reasoning options differ from the start of this run.')
+    }
+    if (!state.routing) {
+      state.routing = routing
+      await save(root, state)
+    }
+    const dispose = evolve.register('loop', scheduleRun(state, allowed, root, providers(state)))
+    try {
+      return await evolve.run({
+        maxBudget: budget, maxPopulation: DEFAULT_MAX_POPULATION, k: DEFAULT_K, candidates: args.candidates,
+      }, exec)
+    } finally {
+      dispose()
+    }
+  }, true)
+}
diff --git a/plugins/dsh-evolve-loop/tests/restricted.node.mjs b/plugins/dsh-evolve-loop/tests/restricted.node.mjs
new file mode 100644
index 0000000..74ddc7a
--- /dev/null
+++ b/plugins/dsh-evolve-loop/tests/restricted.node.mjs
@@ -0,0 +1,135 @@
+import { strict as assert } from 'node:assert'
+import { cp, mkdtemp, readFile, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { test } from 'node:test'
+import { Evolve } from '../src/evolve.js'
+import { defaultInstruction } from '../src/providers/mutate.js'
+import { installRestrictedTools, restrictedToolGuard } from '../src/restricted.js'
+import { executePlugin } from '../src/policy-code.js'
+
+const FIXTURE = fileURLToPath(new URL('./fixtures/task/', import.meta.url))
+
+test('guest hooks use only allowed exports and data-only input', () => {
+  const allowed = ['loop','select','survive']
+  for (const key of ['guidance', 'model', 'evaluate', 'mutate']) {
+    assert.throws(() => executePlugin('return { ' + key + '() {} }', allowed), /Only enabled/)
+  }
+  assert.throws(() => executePlugin('while (true) {}', allowed), /timed out/)
+  const state = { budget: { used: 2 } }
+  const output = executePlugin('return { loop(s) { s.budget.used = 900; return [typeof process, typeof require] } }',
+    allowed, 'loop', state)
+  assert.deepEqual(output, ['undefined', 'undefined'])
+  assert.equal(state.budget.used, 2)
+})
+
+test('orchestrator and Worker keep separate operation sets', () => {
+  const worker = { session: { header: { origin: 'subagent' } } }
+  for (const name of ['write', 'bash', 'plugin_manager', 'candidate-builder']) {
+    assert.ok(restrictedToolGuard({ name }))
+  }
+  assert.equal(restrictedToolGuard({ name: 'evolve_activate' }), undefined)
+  assert.equal(restrictedToolGuard({ name: 'edit', agent: worker }), undefined)
+  assert.ok(restrictedToolGuard({ name: 'evolve_define', agent: worker }))
+  assert.ok(restrictedToolGuard({ name: 'bash', agent: worker }))
+})
+
+test('restricted V1 and V2 use identical core Worker requests and official score path', async () => {
+  const directory = await mkdtemp(join(tmpdir(), 'organon-restricted-'))
+  const initial = await readFile(join(FIXTURE, 'solution.py'), 'utf8')
+  async function exercise(variant) {
+    const task = join(directory, variant)
+    await cp(FIXTURE, task, { recursive: true })
+    const evaluator = join(task, 'evaluator', 'evaluator.py')
+    const evaluatorBefore = await readFile(evaluator)
+    const requests = []
+    const subprocess = {
+      resolveExecutable: async () => 'python',
+      spawn({ argv, cwd }) {
+        assert.equal(cwd, join(task, 'evaluator'))
+        assert.equal(argv.at(-2), task)
+        let text
+        return {
+          done: readFile(argv.at(-1), 'utf8').then(source => {
+            const fitness = Number(source.match(/^VALUE = (\d+)$/m)[1])
+            text = JSON.stringify({ fitness })
+            return { exitCode: 0 }
+          }),
+          collected: { stdout: { readFrom: () => ({ text }) } },
+        }
+      },
+    }
+    const tools = new Map()
+    const ctx = {
+      get: key => key === 'subprocess' ? subprocess : undefined,
+      subagents: {
+        getProvider: () => ({}),
+        async start(name, request) {
+          assert.equal(name, 'candidate-builder')
+          requests.push(request)
+          const result = (async () => {
+            await writeFile(join(request.confine.root, 'solution.py'),
+              initial.replace(/^VALUE = \d+$/m, 'VALUE = ' + String(10 + requests.length)))
+            return { output: [] }
+          })()
+          return { result, dispose: async () => {} }
+        },
+      },
+      tools: { register: tool => tools.set(tool.name, tool), guard: callback => assert.equal(callback, restrictedToolGuard) },
+    }
+    const evolve = new Evolve(ctx)
+    installRestrictedTools(ctx, evolve, x => x, { variant, budget: 9 })
+    const options = { provider: 'fixture', model: 'fixed-model', reasoningEffort: 'none' }
+    const exec = { agent: { options, session: { header: { cwd: task } } } }
+    function call(name, args = {}) { return tools.get(name).execute(args, exec) }
+    assert.equal(tools.has('evolve_set_guidance'), variant === 'v2')
+    await assert.rejects(call('evolve_run', { candidates: 1, max_budget: 900 }), /chunk size/)
+    assert.deepEqual(await call('evolve_run', { candidates: 1 }), { best_id: 'c000001', best_fitness: 11, remaining: 8 })
+    options.model = 'other-model'
+    await assert.rejects(call('evolve_run', { candidates: 1 }), /model route/)
+    options.model = 'fixed-model'
+    const code = 'return { '
+      + 'loop(s) { return Array(Math.min(s.remaining, 3)).fill(null) }, '
+      + 'select(s) { return { parent_id: s.alive.at(-1).id, donors: [s.history[0].id] } }, '
+      + 'survive(s) { return [s.alive.at(-1).id] }'
+      + (variant === 'v2' ? ', guidance(s) { return "Use branch " + s.primary.id }' : '')
+      + ' }'
+    const def = await call('evolve_define', { name: 'Learned policy', purpose: 'Exercise custom hooks', host_code: code })
+    assert.deepEqual((await call('evolve_plugins')).providers, {})
+    await call('evolve_activate', { plugin_id: def.plugin_id })
+    if (variant === 'v2') await call('evolve_set_guidance', { guidance: 'Prioritize small parameter changes.' })
+    assert.deepEqual(await call('evolve_run', { candidates: 8 }), { best_id: 'c000009', best_fitness: 19, remaining: 0 })
+    const status = await call('evolve_status')
+    assert.deepEqual(status.history.slice(2,5).map(row => row.parent), ['c000001', 'c000001', 'c000001'])
+    assert.deepEqual(status.history.filter(r => r.survival === 'yes').map(r => r.id), ['c000009'])
+    assert.equal(status.revisions[0].used, 1)
+    assert.equal(status.routing.model, 'fixed-model')
+    assert.deepEqual((await call('evolve_inspect', { artifact: 'evaluation', candidate_id: 'c000002' })).evaluation, { fitness: 12 })
+    assert.match((await call('evolve_inspect', { artifact: 'source' })).source, /VALUE = 10/)
+    assert.equal((await call('evolve_inspect', { artifact: 'evaluator' })).source, evaluatorBefore.toString())
+    await assert.rejects(call('evolve_inspect', { artifact: 'evaluation', candidate_id: '../other' }), /Unknown/)
+    await call('evolve_deactivate', { plugin_id: def.plugin_id })
+    assert.deepEqual((await call('evolve_plugins')).providers, {})
+    assert.deepEqual(await readFile(evaluator), evaluatorBefore)
+    return requests
+  }
+  try {
+    const v1 = await exercise('v1')
+    const v2 = await exercise('v2')
+    assert.ok(v1[1].prompt[0].text.startsWith(defaultInstruction(11)))
+    assert.match(v1[1].prompt[0].text, /"id":"c000000"/)
+    assert.equal(v1[0].prompt[0].text, v2[0].prompt[0].text)
+    assert.ok(v2[1].prompt[0].text.startsWith(defaultInstruction(11) + '\n\n'))
+    assert.ok(v2[1].prompt[0].text.endsWith('Prioritize small parameter changes.'))
+    assert.ok(v2[2].prompt[0].text.endsWith('Use branch c000001'))
+    for (let i = 0; i < v1.length; i++) {
+      assert.equal(v1[i].persona, v2[i].persona)
+      assert.equal(v1[i].agentOptions, undefined)
+      assert.equal(v2[i].agentOptions, undefined)
+      assert.deepEqual({ ...v1[i].confine, root: null }, { ...v2[i].confine, root: null })
+    }
+  } finally {
+    await rm(directory, { recursive: true, force: true })
+  }
+})
