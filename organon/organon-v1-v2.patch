+/** Run a guest search policy with data-only inputs and a synchronous time bound. */
+import { createContext, Script } from 'node:vm'
+
+export function executePlugin(code, allowed, slot, state) {
+  if (typeof code !== 'string' || !code.trim() || code.length > 32_768) {
+    throw new Error('host_code must contain 1–32,768 characters of JavaScript.')
+  }
+  const input = JSON.stringify(JSON.stringify(state ?? null))
+  const script = new Script(
+    '"use strict"; (() => {\n'
+    + ' const policy = (() => {\n' + code + '\n})();\n'
+    + ' if (policy === null || typeof policy !== "object" || Array.isArray(policy)) '
+    + 'throw new Error("Return an object with search policy functions.");\n'
+    + ' const keys = Object.keys(policy);\n'
+    + ' if (!keys.length || keys.some(key => !' + JSON.stringify(allowed)
+    + '.includes(key) || typeof policy[key] !== "function")) '
+    + 'throw new Error("Only enabled search hooks can be exported: " + ' + JSON.stringify(allowed.join(', ')) + ');\n'
+    + (slot === undefined ? 'return JSON.stringify(keys);\n'
+      : ' const result = policy[' + JSON.stringify(slot) + '](JSON.parse(' + input + '));\n'
+        + ' if (result === undefined || (result && typeof result.then === "function")) '
+        + 'throw new Error("Return a synchronous JSON value.");\n'
+        + ' return JSON.stringify(result);\n')
+    + '})()',
+    { filename: 'organon-policy.js' },
+  )
+  const realm = createContext(Object.create(null), {
+    codeGeneration: { strings: false, wasm: false },
+    microtaskMode: 'afterEvaluate',
+  })
+  const result = script.runInContext(realm, { timeout: 250 })
+  if (typeof result !== 'string' || result.length > 65_536) {
+    throw new Error('Search plugin output must be serializable JSON under 65,536 characters.')
+  }
+  return JSON.parse(result)
+}
