index 0000000..660a1e7
--- /dev/null
+++ b/plugins/dsh-evolve-loop/src/policy-code.js
@@ -0,0 +1,78 @@
+/** Keep guest functions live while passing only serialized data across the VM boundary. */
+import { createContext, Script } from 'node:vm'
+
+const OPTIONS = { timeout: 250 }
+const SOURCE = { filename: 'organon-policy.js' }
+
+export function createPlugin(code, allowed) {
+  if (typeof code !== 'string' || !code.trim() || code.length > 32_768) {
+    throw new Error('host_code must contain 1–32,768 characters of JavaScript.')
+  }
+  const realm = createContext(Object.create(null), {
+    codeGeneration: { strings: false, wasm: false },
+    microtaskMode: 'afterEvaluate',
+  })
+  const initialize = new Script(
+    '"use strict"; const __organon = (() => {\n'
+    + ' const stringify = JSON.stringify, parse = JSON.parse;\n'
+    + ' const policy = (() => {\n' + code + '\n})();\n'
+    + ' if (policy === null || typeof policy !== "object" || Array.isArray(policy)) '
+    + 'throw new Error("Return an object with search policy functions.");\n'
+    + ' const keys = Object.keys(policy);\n'
+    + ' if (!keys.length || keys.some(key => !' + JSON.stringify(allowed)
+    + '.includes(key) || typeof policy[key] !== "function")) '
+    + 'throw new Error("Only enabled search hooks can be exported: " + ' + JSON.stringify(allowed.join(', ')) + ');\n'
+    + ' let frame, memory;\n'
+    + ' return (command, slot, serialized) => {\n'
+    + '   if (command === "list") return stringify(keys);\n'
+    + '   if (command === "close") { frame = undefined; return; }\n'
+    + '   const input = parse(serialized);\n'
+    + '   let result;\n'
+    + '   if (command === "resume") {\n'
+    + '     const step = frame.next(input);\n'
+    + '     if (step && typeof step.then === "function") throw new Error("Use a synchronous generator for loop.");\n'
+    + '     if (step.done) frame = undefined;\n'
+    + '     return stringify({ result: step.value ?? null, yielded: !step.done, memory });\n'
+    + '   }\n'
+    + '   memory ??= input.memory;\n'
+    + '   Object.defineProperty(input, "memory", { enumerable: true, get: () => memory, set: value => { memory = value } });\n'
+    + '   result = policy[slot](input);\n'
+    + '   if (slot === "loop" && result && typeof result.next === "function") {\n'
+    + '     frame = result;\n'
+    + '     const step = frame.next();\n'
+    + '     if (step && typeof step.then === "function") throw new Error("Use a synchronous generator for loop.");\n'
+    + '     if (step.done) frame = undefined;\n'
+    + '     return stringify({ result: step.value ?? null, yielded: !step.done, finished: step.done, memory });\n'
+    + '   }\n'
+    + '   if (result === undefined || (result && typeof result.then === "function")) '
+    + 'throw new Error("Return a synchronous JSON value.");\n'
+    + '   return stringify({ result, memory });\n'
+    + ' };\n'
+    + '})(); __organon("list");',
+    SOURCE,
+  )
+  const slots = JSON.parse(initialize.runInContext(realm, OPTIONS))
+  function callGuest(command, slot, input) {
+    const args = [command, slot, JSON.stringify(input)].map(value => JSON.stringify(value))
+    const call = new Script('__organon(' + args.join(',') + ');', SOURCE)
+    const output = call.runInContext(realm, OPTIONS)
+    if (command === 'close') return
+    if (typeof output !== 'string' || output.length > 65_536) {
+      throw new Error('Search plugin output and memory must fit in 65,536 JSON characters.')
+    }
+    const value = JSON.parse(output)
+    if (!Object.hasOwn(value, 'result') || !value.memory || typeof value.memory !== 'object' || Array.isArray(value.memory)) {
+      throw new Error('Return a JSON result and preserve state.memory as a JSON object.')
+    }
+    return value
+  }
+  return {
+    slots,
+    invoke(slot, state) {
+      if (!slots.includes(slot)) throw new Error('Inactive search hook: ' + slot)
+      return callGuest('invoke', slot, state)
+    },
+    resume(value) { return callGuest('resume', null, value) },
+    close() { callGuest('close', null, null) },
+  }
+}
