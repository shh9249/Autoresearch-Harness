+  const result = await activate(`return { apply(ctx) {
+    let n = 0
+    ctx.evolve.register('guidance', async ({parent}, e) => {
+      if (!(await e.population().rows()).some(r => r.id === parent)) throw Error('Missing parent')
+      try { await ctx.evolve.population().write([]) } catch { return 'Explore ' + (++n) }
+      throw Error('Guidance modified the search')
+    })
+    ctx.evolve.register('select', async pop => ({
+      parent:'c000000', donors:(await pop.rows()).slice(1,6).map(r => r.id)
+    }))
+  } }`)
+  expect(result.ok, result.message).toBe(true)
