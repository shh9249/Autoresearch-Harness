+it('binds population ancestry to allocation and dispatch on both generation paths', async () => {
+  const { activate, call, workers, task } = await setup('v1')
+  await call('evolve_run', { max_budget: 4, candidates: 1 })
+  const result = await activate(`return {apply(ctx) { ctx.evolve.register('loop', async (_, e) => {
+    async function refused(f) { try { await f() } catch { return }; throw Error('Accepted invalid lineage') }
+    const p = 'c000000', d = 'c000001', pop = e.population()
+    for (const donors of [[p], [d,d], ['c999999'], [5]]) {
+      await refused(() => e.mutate({parent:p, donors}))
+    }
+    const first = await e.mutate({parent:p, donors:[d]})
+    const child = await e.allocate(d)
+    await refused(() => e.spawnWorker(child.dir, {donors:[child.id]}))
+    await e.spawnWorker(child.dir, {donors:[first.id,p]})
+    const row = { id:child.id, parent:d, fitness:await e.evaluate(child), survival:'yes' }
+    for (const parent of [null,p,child.id,'c999999']) await refused(() => pop.append({...row,parent}))
+    await refused(() => pop.append({...row,donors:[p,first.id]}))
+    await pop.append(row)
+    const rows = await pop.rows()
+    await refused(() => pop.write(rows.map(r => r.id === d ? {...r,parent:child.id} : r)))
+    await refused(() => pop.write(rows.map(r => r.id === p ? {...r,parent:d} : r)))
+    await refused(() => e.files.write('lineage/' + d + '.json','{}'))
+    await pop.write(rows)
+    return (await pop.rows()).at(-1)
+  })} }`)
+  expect(result.ok, result.message).toBe(true)
+  expect(await call('evolve_run', {max_budget:4,candidates:2})).toMatchObject({
+    id:'c000003',parent:'c000001',donors:['c000002','c000000'],
+  })
+  expect(workers).toHaveLength(3)
+  expect(JSON.parse(await readFile(join(task,'run/lineage/c000002.json'),'utf8'))).toEqual({parent:'c000000',donors:['c000001']})
+})
