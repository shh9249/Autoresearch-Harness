+  await cp(fileURLToPath(new URL('./fixtures/task/', import.meta.url)), task, { recursive: true })
+  const agent = { id: 'S-search', session: { id: 'S-search', header: { cwd: task } }, inject() {}, steer() {} }
+  const workers: any[] = []
+  ctx = new Context()
+  await ctx.plugin(SystemPrompt)
+  await ctx.plugin(Tools)
+  await ctx.plugin(Subprocess)
+  await ctx.plugin({ name: 'fixture-worker', apply(scope) {
+    scope.provide('subagents', { getProvider: () => ({}), async start(_name: string, req: any) {
+      workers.push(req)
+      return { result: Promise.resolve({ output: [], stopReason: 'completed' }), dispose() {} }
+    } } as never)
+  } })
+  await ctx.plugin(Runner)
+  await ctx.plugin(organon)
+  function call(name: string, args: object) {
+    return ctx.tools.get(name)!.execute(args as never, {
+      agent, name, callId: name, signal: new AbortController().signal,
+    } as never) as Promise<any>
+  }
+  async function activate(body: string) {
+    const { plugin_id } = await call('evolve_define', { name: 'policy', purpose: 'test', host_code: body })
+    return call('evolve_activate', { plugin_id })
+  }
+  return { activate, workers, call, task }
